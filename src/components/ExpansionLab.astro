---
import '../styles/expansion-lab.css';

const principles = [
  ['01', 'Claridad', 'Si no se puede explicar, todavía no está listo para construirse.'],
  ['02', 'Ritmo', 'Entregas pequeñas, feedback temprano y cero sorpresas al final.'],
  ['03', 'Criterio', 'Elegimos la solución que resuelve el problema, no la que suena más compleja.'],
  ['04', 'Cuidado', 'Detalles, accesibilidad y performance son parte del producto, no extras.'],
];

const milestones = [
  ['01', 'Alineación', 'Días 01—03', 'Eliminamos supuestos y definimos cómo se ve el éxito.'],
  ['02', 'Dirección', 'Semana 01', 'Una ruta visual y técnica que todo el equipo puede defender.'],
  ['03', 'Construcción', 'Semanas 02—05', 'Sprints de alta señal con demos reales y decisiones visibles.'],
  ['04', 'Lanzamiento', 'Semana 06+', 'Medimos el resultado, aprendemos y activamos el siguiente ciclo.'],
];

const services = [
  { id: 'brand', label: 'Brand systems', icon: '✦', title: 'Una señal que la gente reconoce.', text: 'Posicionamiento, identidad y lenguaje visual para dejar de parecer una opción más.', bullets: ['Naming & voice', 'Visual direction', 'Design systems'], color: 'yellow' },
  { id: 'product', label: 'Digital products', icon: '⌘', title: 'Productos que dan ganas de usar.', text: 'Experiencias digitales que convierten complejidad en una secuencia clara de acciones.', bullets: ['UX research', 'Prototyping', 'Interface design'], color: 'blue' },
  { id: 'engineering', label: 'Engineering', icon: '⌁', title: 'Código listo para el siguiente orden.', text: 'Arquitectura mantenible, interfaces rápidas y una base que no se rompe al crecer.', bullets: ['Astro & React', 'APIs & edge', 'Quality & DX'], color: 'teal' },
];
---

<section class="expansion-intro" aria-labelledby="expansion-title">
  <div class="expansion-intro__copy">
    <span class="eyebrow">12 / EL SISTEMA CLICK</span>
    <h2 id="expansion-title">No es una<br /><span class="expansion-mark">página.</span><br />Es movimiento.</h2>
    <p>Una experiencia digital tiene ritmo: atrae, explica, demuestra y convierte. Construimos cada capa para que el usuario siempre sepa cuál es el siguiente click.</p>
    <a class="text-link" href="#principios">Ver nuestros principios <span>↓</span></a>
  </div>
  <div class="signal-meter" aria-label="Estado del sistema de experiencia">
    <div class="signal-meter__header"><span>EXPERIENCE / OS</span><span class="signal-online"><i></i> ONLINE</span></div>
    <div class="signal-meter__body">
      <div class="signal-orbit"><span class="signal-orbit__core">C</span><i></i><i></i><i></i></div>
      <div class="signal-readout"><span>COHERENCE</span><strong>98.7</strong><small>/ 100</small><div class="readout-bar"><i></i></div></div>
      <div class="signal-readout"><span>FRICTION</span><strong>02.1</strong><small>/ 100</small><div class="readout-bar readout-bar--blue"><i></i></div></div>
    </div>
    <div class="signal-meter__footer"><span>SYNCED: NOW</span><span>NODE: 04</span><span>LATENCY: 12ms</span></div>
  </div>
</section>

<section class="service-explorer" aria-labelledby="explorer-title">
  <div class="service-explorer__heading"><span class="eyebrow">13 / EXPLORADOR DE SERVICIOS</span><h2 id="explorer-title">Elige una<br /><span class="outline-text">frecuencia.</span></h2><p>Haz click en una capacidad para ver qué cambia cuando la ponemos en el centro.</p></div>
  <div class="service-explorer__layout">
    <div class="service-tabs" role="tablist" aria-label="Servicios de Click">
      {services.map((service, index) => <button class={`service-tab ${index === 0 ? 'is-active' : ''}`} type="button" role="tab" aria-selected={index === 0} data-service-tab={service.id}><span class={`service-tab__icon service-tab__icon--${service.color}`}>{service.icon}</span><span><small>0{index + 1}</small>{service.label}</span><b>↗</b></button>)}
    </div>
    <div class="service-detail">
      {services.map((service, index) => <article class={`service-detail__panel ${index === 0 ? 'is-active' : ''}`} data-service-panel={service.id} aria-hidden={index !== 0}><div class={`service-detail__visual service-detail__visual--${service.color}`}><span>{service.icon}</span><i>CLICK<br />STUDIO</i><b>0{index + 1}</b></div><div class="service-detail__copy"><span class="eyebrow">CAPABILITY / 0{index + 1}</span><h3>{service.title}</h3><p>{service.text}</p><ul>{service.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}</ul><a href="#contacto" class="button button-blue">Explorar esta ruta <span>→</span></a></div></article>)}
    </div>
  </div>
</section>

<section class="principles-section" id="principios" aria-labelledby="principles-title">
  <div class="principles-heading"><span class="eyebrow">14 / PRINCIPIOS DE OPERACIÓN</span><h2 id="principles-title">La calidad<br /><span class="highlight">se nota.</span></h2><p>No hay trucos: hay decisiones consistentes repetidas con atención. Así se construye algo que se siente inevitable.</p></div>
  <div class="principles-grid">{principles.map(([number, title, text]) => <article class="principle-card"><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div><i>↗</i></article>)}</div>
</section>

<section class="milestones-section" aria-labelledby="milestones-title">
  <div class="milestones-heading"><span class="eyebrow">15 / SECUENCIA DE ENTREGA</span><h2 id="milestones-title">Cada etapa<br />deja <span>algo real.</span></h2></div>
  <div class="milestones-track">{milestones.map(([number, title, time, text]) => <article class="milestone"><div class="milestone__number">{number}</div><div class="milestone__line"><i></i></div><div class="milestone__copy"><small>{time}</small><h3>{title}</h3><p>{text}</p></div></article>)}</div>
</section>

<section class="marquee-section" aria-label="Tecnologías de Click">
  <div class="marquee-row marquee-row--one"><span>ASTRO</span><i>✦</i><span>THREE.JS</span><i>✦</i><span>CLOUDFLARE</span><i>✦</i><span>REACT</span><i>✦</i><span>ASTRO</span><i>✦</i><span>THREE.JS</span></div>
  <div class="marquee-row marquee-row--two"><span>RESEARCH</span><i>+</i><span>DESIGN SYSTEMS</span><i>+</i><span>PRODUCT THINKING</span><i>+</i><span>RESEARCH</span><i>+</i><span>DESIGN SYSTEMS</span></div>
</section>

<section class="manifesto-panel">
  <div class="manifesto-panel__mark">✳</div>
  <div><span class="eyebrow">16 / UNA ÚLTIMA IDEA</span><h2>Lo memorable<br />también puede<br /><span>funcionar.</span></h2></div>
  <p>Diseño con personalidad. Ingeniería con criterio. El resultado es una experiencia que no solo llama la atención: hace avanzar el negocio.</p>
</section>

<script>
  const serviceTabs = document.querySelectorAll<HTMLButtonElement>('[data-service-tab]');
  const servicePanels = document.querySelectorAll<HTMLElement>('[data-service-panel]');
  serviceTabs.forEach((tab) => tab.addEventListener('click', () => {
    const selected = tab.dataset.serviceTab;
    serviceTabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
    });
    servicePanels.forEach((panel) => {
      const active = panel.dataset.servicePanel === selected;
      panel.classList.toggle('is-active', active);
      panel.setAttribute('aria-hidden', String(!active));
    });
  }));

  const revealItems = document.querySelectorAll<HTMLElement>('.principle-card, .milestone, .manifesto-panel');
  const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
    if (entry.isIntersecting) entry.target.classList.add('is-revealed');
  }), { threshold: 0.12 });
  revealItems.forEach((item) => revealObserver.observe(item));
</script>
