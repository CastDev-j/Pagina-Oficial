---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Click — Experiencias memorables en un solo click',
  description = 'Desarrollo de páginas web corporativas y soluciones de software a la medida para empresas, pymes y emprendimientos.',
  image = '/logo.svg',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo.png" />
    <title>{title}</title>

    <!-- Google Fonts con precarga y display=swap para 0 ms TBT y CLS = 0 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO, Open Graph & Structured Data de Click -->
    <SEOHead title={title} description={description} image={image} />
  </head>
  <body>
    <slot />
  </body>
</html>
