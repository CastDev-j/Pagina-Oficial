---
import Layout from '../layouts/Layout.astro';
import FeatureLab from '../components/FeatureLab.astro';
import ThreeShowcase from '../components/ThreeShowcase.astro';
import ExpansionLab from '../components/ExpansionLab.astro';
import PremiumLab from '../components/PremiumLab.astro';
import SingularityLab from '../components/SingularityLab.astro';
import MotionSystem from '../components/MotionSystem.astro';

const services = [
  {
    number: '01',
    title: 'Web que convierte',
    description: 'Sitios corporativos con una idea clara, una narrativa que engancha y performance que se siente instantánea.',
    tags: ['UX / UI', 'Astro', 'SEO'],
    color: 'teal',
  },
  {
    number: '02',
    title: 'Software a medida',
    description: 'Productos digitales que ordenan operaciones complejas y hacen que tu equipo trabaje mejor.',
    tags: ['Producto', 'APIs', 'Cloudflare'],
    color: 'blue',
  },
  {
    number: '03',
    title: 'Sistemas que escalan',
    description: 'Arquitectura sólida para pasar de la primera versión a miles de usuarios sin perder velocidad.',
    tags: ['DX', 'CI/CD', 'Observabilidad'],
    color: 'yellow',
  },
];

const steps = [
  ['01', 'Descubrimos', 'Aterrizamos el problema, el negocio y la oportunidad real.'],
  ['02', 'Diseñamos', 'Convertimos estrategia en interfaces que dan ganas de usar.'],
  ['03', 'Construimos', 'Código limpio, entregas rápidas y decisiones medibles.'],
  ['04', 'Lanzamos', 'Medimos, aprendemos y dejamos el sistema listo para crecer.'],
];

const projects = [
  ['01', 'Launch / 01', 'Una identidad digital que sale del molde y llega lista para vender.', 'BRANDING + WEB', 'blue'],
  ['02', 'Ops / 02', 'Un sistema interno que convierte procesos lentos en decisiones rápidas.', 'PRODUCTO + SOFTWARE', 'yellow'],
  ['03', 'Scale / 03', 'Una plataforma preparada para crecer sin sacrificar experiencia.', 'ARQUITECTURA + CLOUD', 'teal'],
];
---

<Layout
  title="Click — Ingeniería digital con actitud"
  description="Diseñamos y construimos productos digitales rápidos, memorables y listos para crecer."
>
  <div class="site-shell">
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <header class="topbar">
      <a href="/" class="wordmark" aria-label="Click, inicio">
        <img src="/logo.svg" alt="" width="36" height="36" />
        <span>CLICK<span class="wordmark-dot">.</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#metodo">Método</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <div class="header-tools">
        <button class="icon-button menu-trigger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">☰</button>
        <button class="icon-button contrast-trigger" type="button" aria-pressed="false" aria-label="Activar modo de alto contraste">◐</button>
      </div>
      <a class="button button-small button-yellow" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </header>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Navegación móvil" hidden>
      <a href="#servicios">Servicios <span>01</span></a>
      <a href="#metodo">Método <span>02</span></a>
      <a href="#contacto">Contacto <span>03</span></a>
    </nav>

    <main>
      <section class="hero section-grid" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="status-dot"></span> ESTUDIO DIGITAL / ONLINE</div>
          <h1 id="hero-title">Ideas grandes.<br /><span class="highlight">Código</span> que responde.</h1>
          <p class="hero-lede">Diseñamos experiencias digitales memorables y construimos el software que las hace posibles. Sin humo. Sin plantillas. En un solo click.</p>
          <div class="hero-actions">
            <a class="button button-yellow" href="#contacto">Iniciar un proyecto <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#servicios">Explorar capacidades <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof">
            <div class="avatar-stack" aria-hidden="true"><span>✦</span><span>+</span><span>⚡</span></div>
            <p>Hecho para equipos que<br /><strong>no quieren verse iguales.</strong></p>
          </div>
        </div>

        <div class="window hero-window" aria-label="Monitor de estado de Click">
          <div class="window-bar">
            <span><i class="window-signal"></i> click_os / overview</span>
            <div class="window-controls" aria-hidden="true"><b>_</b><b>□</b><b>×</b></div>
          </div>
          <div class="terminal">
            <div class="terminal-top"><span>LIVE_BUILD</span><span class="green">● ONLINE</span></div>
            <div class="terminal-command"><span class="prompt">click@studio:~$</span> ship your boldest idea</div>
            <div class="terminal-art" aria-hidden="true">
              <div class="art-circle"></div><div class="art-spark spark-one">✦</div><div class="art-spark spark-two">✳</div>
              <span class="art-label">MAKE<br />IT<br /><em>CLICK</em></span>
            </div>
            <div class="terminal-log" aria-live="polite">
              <p><span class="log-blue">[INFO]</span> compiling good ideas...</p>
              <p><span class="log-yellow">[WAIT]</span> removing unnecessary jargon</p>
              <p><span class="log-green">[ OK ]</span> ready to make noise <b>█</b></p>
            </div>
          </div>
          <div class="window-status"><span>BRANCH: main</span><span>BUILD 100%</span><span>LATENCY: 24ms</span></div>
        </div>
      </section>

      <div class="ticker" aria-label="Tecnologías y capacidades">
        <div class="ticker-track"><span>WEB EXPERIENCES</span><b>✦</b><span>PRODUCT THINKING</span><b>✦</b><span>SOFTWARE CRAFT</span><b>✦</b><span>WEB EXPERIENCES</span><b>✦</b><span>PRODUCT THINKING</span><b>✦</b></div>
      </div>

      <section class="impact-strip" aria-label="Métricas de Click">
        <div><strong>100<span>%</span></strong><small>DEDICACIÓN<br />A CADA DETALLE</small></div>
        <div><strong>24<span>ms</span></strong><small>LATENCIA<br />DE REFERENCIA</small></div>
        <div><strong>0<span>px</span></strong><small>PLANTILLAS<br />UTILIZADAS</small></div>
        <div><strong>1<span>×</span></strong><small>BUEN CLICK<br />PARA EMPEZAR</small></div>
      </section>

      <section id="servicios" class="section services-section">
        <div class="section-heading"><div><span class="eyebrow">01 / LO QUE HACEMOS</span><h2>No hacemos<br /><span class="outline-text">lo de siempre.</span></h2></div><p class="section-intro">La tecnología es nuestra herramienta. La diferencia está en cómo pensamos cada detalle para que tu negocio avance.</p></div>
        <div class="service-grid">
          {services.map((service) => (
            <article class={`service-card card-${service.color}`}>
              <div class="card-top"><span class="card-number">{service.number}</span><span class="arrow-circle" aria-hidden="true">↗</span></div>
              <div class={`service-icon icon-${service.color}`} aria-hidden="true">{service.color === 'teal' ? '✳' : service.color === 'blue' ? '⌘' : '▦'}</div>
              <h3>{service.title}</h3><p>{service.description}</p>
              <div class="tag-row">{service.tags.map((tag) => <span>{tag}</span>)}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="work-section section">
        <div class="section-heading"><div><span class="eyebrow">01.5 / LO QUE HEMOS HECHO</span><h2>Trabajo con<br /><span class="outline-text">intención.</span></h2></div><p class="section-intro">Cada entrega es una oportunidad para hacer que un negocio se mueva distinto. Aquí empieza una pequeña muestra.</p></div>
        <div class="project-grid">
          {projects.map(([number, title, description, category, color]) => (
            <article class={`project-card project-${color}`}>
              <div class="project-meta"><span>{number}</span><span>{category}</span></div>
              <div class="project-visual" aria-hidden="true"><span class="project-shape"></span><strong>{title.split(' / ')[0]}</strong><i>↗</i></div>
              <h3>{title}</h3><p>{description}</p><a href="#contacto" class="project-link">Ver cómo lo haríamos <span>→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="capabilities-section">
        <div class="capabilities-heading"><span class="eyebrow">02.5 / STACK DE CONFIANZA</span><h2>Diseño con<br /><span class="highlight-blue">futuro.</span></h2><p>No elegimos herramientas por moda. Las elegimos porque hacen que tu producto sea más rápido, seguro y agradable de mantener.</p></div>
        <div class="capability-grid">
          <div class="capability-card"><span class="capability-mark">◈</span><strong>Frontend</strong><p>Astro · React · TypeScript</p><b>PERFORMANCE FIRST</b></div>
          <div class="capability-card"><span class="capability-mark">⌁</span><strong>Infraestructura</strong><p>Cloudflare · Edge · CI/CD</p><b>READY TO SCALE</b></div>
          <div class="capability-card"><span class="capability-mark">⌘</span><strong>Producto</strong><p>Research · UX · Sistemas</p><b>HUMAN CENTERED</b></div>
          <div class="capability-card"><span class="capability-mark">✓</span><strong>Calidad</strong><p>Accesibilidad · SEO · Tests</p><b>BUILT TO LAST</b></div>
        </div>
      </section>

      <section id="metodo" class="method-section">
        <div class="method-intro"><span class="eyebrow">02 / CÓMO TRABAJAMOS</span><h2>Rápidos para<br /><span class="highlight-blue">pensar.</span><br />Obsesivos para<br />construir.</h2><p>Un proceso directo, colaborativo y sin reuniones que pudieron ser un email.</p></div>
        <div class="steps-list">
          {steps.map(([number, title, description]) => <div class="step"><span class="step-number">{number}</span><div><h3>{title}</h3><p>{description}</p></div><span class="step-arrow">↗</span></div>)}
        </div>
      </section>

      <section class="manifesto section-grid">
        <div class="manifesto-copy"><span class="eyebrow">03 / NUESTRA FORMA DE VERLO</span><h2>Tu proyecto<br />merece <span class="highlight">más click.</span></h2><p>La monotonía digital es un problema de negocio. Si tu producto se ve y se siente como todos, nadie recuerda por qué elegirte. Nosotros hacemos que la primera impresión trabaje a tu favor.</p><a class="button button-blue" href="#contacto">Conoce nuestro enfoque <span>→</span></a></div>
        <div class="quote-card"><span class="quote-mark">“</span><blockquote>La buena tecnología no debería sentirse complicada. Debería sentirse inevitable.</blockquote><div class="quote-footer"><span class="mini-avatar">C</span><span>CLICK STUDIO<br /><small>ENGINEERING WITH ATTITUDE</small></span></div></div>
      </section>

      <section class="faq-section section">
        <div class="faq-heading"><span class="eyebrow">03.5 / PREGUNTAS RÁPIDAS</span><h2>Lo que quieres<br /><span class="outline-text">saber.</span></h2><p>Si tu pregunta no está aquí, escríbenos. Somos bastante buenos contestando mensajes.</p></div>
        <div class="faq-list">
          <details open><summary>¿Con qué tipo de proyectos trabajan? <span>+</span></summary><p>Trabajamos con equipos que necesitan lanzar, reposicionar o mejorar un producto digital: desde una web corporativa hasta una plataforma completa.</p></details>
          <details><summary>¿Qué pasa después del primer contacto? <span>+</span></summary><p>Respondemos en menos de 48 horas para entender el reto, definir el siguiente paso y decirte con honestidad si somos el equipo correcto.</p></details>
          <details><summary>¿Pueden trabajar con nuestro equipo interno? <span>+</span></summary><p>Sí. Nos integramos como equipo de producto, diseño o ingeniería según lo que necesites, con comunicación clara y entregas visibles.</p></details>
          <details><summary>¿Cómo mantienen el rendimiento? <span>+</span></summary><p>Diseñamos con performance desde el inicio: menos dependencias, imágenes optimizadas, arquitectura estática cuando es posible y métricas en cada entrega.</p></details>
        </div>
      </section>

      <section class="testimonial-section section">
        <div class="testimonial-top"><span class="eyebrow">03.8 / SEÑAL RECIBIDA</span><span class="live-chip"><i></i> FEEDBACK REAL</span></div>
        <blockquote>“Click entendió lo que queríamos decir antes de que supiéramos cómo decirlo.”</blockquote>
        <div class="testimonial-author"><span class="mini-avatar">M</span><span><strong>Mariana R.</strong><small>FOUNDING TEAM / PRODUCT LEAD</small></span></div>
      </section>

      <FeatureLab />
      <ThreeShowcase />
      <ExpansionLab />
      <PremiumLab />
      <SingularityLab />
      <MotionSystem />

      <section id="contacto" class="contact-section">
        <div class="contact-top"><span class="eyebrow">04 / EL SIGUIENTE CLICK</span><h2>Cuéntanos<br /><span class="highlight">qué tienes</span> en mente.</h2><p>Cuatro líneas son suficientes para empezar. Te respondemos en menos de 48 horas.</p></div>
        <form class="contact-form" action="mailto:hola@click.digitalandia.com" method="post" enctype="text/plain">
          <label><span>01 / TU NOMBRE</span><input type="text" name="nombre" placeholder="Jane Doe" required /></label>
          <label><span>02 / TU EMAIL</span><input type="email" name="email" placeholder="jane@empresa.com" required /></label>
          <label class="full-label"><span>03 / CUÉNTANOS SOBRE EL PROYECTO</span><textarea name="proyecto" rows="3" placeholder="Tenemos una idea que..."></textarea></label>
          <button class="button button-yellow submit-button" type="submit">Enviar mensaje <span aria-hidden="true">↗</span></button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <footer class="footer"><div class="footer-brand"><img src="/logo.svg" alt="" width="32" height="32" /><strong>CLICK<span>.</span></strong><p>Experiencias memorables<br />en un solo click.</p></div><div class="footer-links"><a href="mailto:hola@click.digitalandia.com">hola@click.digitalandia.com ↗</a><a href="https://github.com/Click-Software">GitHub ↗</a><span>© 2025 CLICK STUDIO</span></div></footer>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const formStatus = document.querySelector<HTMLElement>('.form-status');
  const terminalLog = document.querySelector<HTMLElement>('.terminal-log');
  const progress = document.querySelector<HTMLElement>('.reading-progress span');
  const menuTrigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const contrastTrigger = document.querySelector<HTMLButtonElement>('.contrast-trigger');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('nombre') || '').trim();
    const email = String(data.get('email') || '').trim();
    const project = String(data.get('proyecto') || '').trim();

    if (!name || !email) return;

    const subject = encodeURIComponent(`Nuevo proyecto desde Click — ${name}`);
    const body = encodeURIComponent(`Nombre: ${name}\nEmail: ${email}\n\nProyecto:\n${project || 'Pendiente de definir'}`);
    window.location.href = `mailto:hola@click.digitalandia.com?subject=${subject}&body=${body}`;
    if (formStatus) formStatus.textContent = 'ABRIENDO TU CLIENTE DE CORREO...';
  });

  const terminalMessages = [
    '<p><span class="log-blue">[INFO]</span> compiling good ideas...</p>',
    '<p><span class="log-yellow">[WAIT]</span> removing unnecessary jargon</p>',
    '<p><span class="log-green">[ OK ]</span> ready to make noise <b>█</b></p>',
  ];
  let messageIndex = 0;

  window.setInterval(() => {
    if (!terminalLog) return;
    messageIndex = (messageIndex + 1) % terminalMessages.length;
    terminalLog.innerHTML = `${terminalMessages[messageIndex]}${terminalMessages[(messageIndex + 1) % terminalMessages.length]}`;
  }, 3200);

  document.querySelectorAll<HTMLDetailsElement>('.faq-list details').forEach((item) => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        document.querySelectorAll<HTMLDetailsElement>('.faq-list details').forEach((other) => {
          if (other !== item) other.removeAttribute('open');
        });
      }
    });
  });

  menuTrigger?.addEventListener('click', () => {
    const isOpen = menuTrigger.getAttribute('aria-expanded') === 'true';
    menuTrigger.setAttribute('aria-expanded', String(!isOpen));
    if (mobileMenu) mobileMenu.hidden = isOpen;
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    mobileMenu.hidden = true;
    menuTrigger?.setAttribute('aria-expanded', 'false');
  }));
  contrastTrigger?.addEventListener('click', () => {
    const active = document.body.classList.toggle('high-contrast');
    contrastTrigger.setAttribute('aria-pressed', String(active));
  });
  window.addEventListener('scroll', () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
  }, { passive: true });
</script>
