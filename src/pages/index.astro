---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Click — Experiencias memorables en un solo click"
  description="Desarrollo de páginas web corporativas y soluciones de software a la medida para empresas, pymes y emprendimientos."
>
  <main class="minimal-stage">
    <div class="brand-unit">
      <img src="/logo.svg" alt="Click" width="110" height="110" class="brand-logo" />
      <h1 class="brand-name">Click</h1>
      <p class="brand-slogan">Experiencias memorables en un solo click.</p>
    </div>
  </main>
</Layout>

<style>
  .minimal-stage {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: #ffffff;
  }

  .brand-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
  }

  .brand-logo {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }

  .brand-name {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #121212;
    margin: 0;
  }

  .brand-slogan {
    font-size: 0.95rem;
    color: #52525b;
    font-weight: 500;
    margin: 0;
    max-width: 320px;
    line-height: 1.4;
  }
</style>
