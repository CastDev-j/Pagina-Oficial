---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404: No Encontrado — Click"
  description="La página solicitada no existe."
>
  <main class="not-found-stage">
    <div class="brand-unit">
      <h1 class="code">404</h1>
      <p class="desc">Página no encontrada.</p>
      <a href="/" class="back-link">← Volver al inicio</a>
    </div>
  </main>
</Layout>

<style>
  .not-found-stage {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: #ffffff;
  }

  .brand-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .code {
    font-size: 3rem;
    font-weight: 800;
    color: #121212;
    margin: 0;
    line-height: 1;
  }

  .desc {
    color: #52525b;
    font-size: 0.95rem;
    margin: 0;
  }

  .back-link {
    color: #121212;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 0.5rem;
  }
</style>
